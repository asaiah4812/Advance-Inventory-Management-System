# Copy to backend/project/.env (or set in your shell) for local development.
# Never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.0

# Mobile app — set in frontend/services/api.ts or EXPO_PUBLIC_API_URL
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
