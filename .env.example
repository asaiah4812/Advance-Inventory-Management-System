# Copy to backend/project/.env (or set in Vercel / your shell) for development & production.
# Never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.0

# Required on Vercel (SQLite does not work on serverless — use Neon, Supabase, or Vercel Postgres)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Required on Vercel for product images (free tier available)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Production (Vercel) — set these in the Vercel dashboard:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=dreaminventory.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dreaminventory.vercel.app
# PUBLIC_API_URL=https://dreaminventory.vercel.app

# Mobile app — optional override in frontend/.env
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# Hosted site URL for dashboard "Online · HTTPS" QR (no trailing slash)
# PUBLIC_API_URL=https://inventory.yourdomain.com
# MOBILE_API_PORT=8000
