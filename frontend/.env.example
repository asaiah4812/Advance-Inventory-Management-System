# --- Expo Go (development) ---
# IP is taken automatically from the Expo dev server (Metro / QR code).

# --- Installed APK ---
# On the same Wi‑Fi, the app scans your network for Django on port 8000.
# Run on PC: python manage.py runserver 0.0.0.0:8000

# Optional: force a fixed URL (skips auto scan)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Optional: Django port (default 8000)
# EXPO_PUBLIC_API_PORT=8000
